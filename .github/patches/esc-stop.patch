+/// Windows-only options for remote-first and home theater use.
+class HtpcOptionsSettingsScreen extends StatelessWidget {
+  const HtpcOptionsSettingsScreen({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return SettingsPage(
+      title: Text(t.settings.htpcOptions),
+      children: [
+        SettingsGroup(
+          title: t.settings.htpcOptions,
+          children: [
